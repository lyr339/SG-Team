{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/main/index.ts!",
        "src/preload/index.ts!",
        "src/renderer/src/main.tsx!",
        "src/renderer/src/preview/preview-main.tsx",
        "src/mcp/index.ts!",
        "scripts/app-shot.mjs",
        "scripts/patch-cursor-usage-hook.ts",
        "scripts/prepare-notification-native-acceptance.mjs",
        "scripts/unpatch-cursor.ts!",
        "scripts/verify-*.{ts,mjs}",
        "docs/design/sg-monogram/generate.cjs",
        "tests/**/*.test.{ts,tsx}",
        "electron.vite.config.ts",
        "src/renderer/src/team/collaboration-layout.worker.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.{ts,tsx}",
        "docs/design/sg-monogram/*.cjs",
        "!src/renderer/src/preview/**!",
        "!src/infrastructure/task-pool/in-memory-task-pool-repository.ts!"
      ]
    },
    "packages/cursor-wire-runtime": {
      "project": [
        "*.mjs",
        "*.d.ts"
      ]
    }
  }
}
